# Cloudflare R2 asset store — used by `npm run assets:push` (maintainers only).
# Pulls use the public ASSETS_BASE_URL and need no credentials.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=static-assets
# Public read base URL of the bucket (r2.dev or custom domain), no trailing slash
ASSETS_BASE_URL=https://static-assets.open-meteo.com

# --- Basemap (optional, picked up at build / dev-server start) ----------------
# Order in which basemap providers are tried. The first one that loads is used,
# the others are automatic fallbacks. Names: maptoolkit, open-meteo, openfreemap.
# A shorter list switches the missing providers off, e.g. `open-meteo,openfreemap`
# turns Maptoolkit off (its Community License limits who may use it: see README).
VITE_BASEMAP_PROVIDERS=maptoolkit,open-meteo,openfreemap
# Label language of the Maptoolkit basemap: ar cs de en es fr hi hu it ja ko pl zh,
# or `local` for Maptoolkit's own default (local names plus a Latin subtitle, so
# Bengali + English in Bangladesh; MapLibre draws Bengali letters unevenly).
VITE_MAPTOOLKIT_LANGUAGE=en
