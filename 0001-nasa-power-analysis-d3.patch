+				void move(e.altKey ? 0 : 1);
+				break;
+			case 'ArrowUp':
+				e.preventDefault();
+				void move(-1);
+				break;
+			case 'PageDown':
+				e.preventDefault();
+				void move(8);
+				break;
+			case 'PageUp':
+				e.preventDefault();
+				void move(-8);
+				break;
+			case 'Home':
+				if (open) {
+					e.preventDefault();
+					void move('home');
+				}
+				break;
+			case 'End':
+				if (open) {
+					e.preventDefault();
+					void move('end');
+				}
+				break;
+			case 'Enter':
