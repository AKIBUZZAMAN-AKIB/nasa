{
	"name": "earth-system-trend-explorer",
	"private": true,
	"version": "0.0.3",
	"type": "module",
	"author": "Team DIVERGENT (AKIBUZZAMAN AKIB <akibuzzaman999@gmail.com>)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AKIBUZZAMAN-AKIB/nasa.git"
	},
	"homepage": "https://github.com/AKIBUZZAMAN-AKIB/nasa#readme",
	"license": "GPL-2.0-only",
	"description": "Earth System Trend Explorer by DIVERGENT: find what changes in NASA Earth observation data and understand what matters (NASA Space Apps Challenge 2026).",
	"keywords": [
		"nasa",
		"space-apps-challenge",
		"earth-observation",
		"climate-trends",
		"mann-kendall",
		"bangladesh",
		"sveltekit"
	],
	"scripts": {
		"dev": "vite dev",
		"prebuild": "node scripts/assets.mjs pull shared",
		"build": "vite build",
		"build:onefile": "node scripts/build-onefile.mjs",
		"preview": "vite preview --port 5173",
		"serve:onefile": "node scripts/serve-onefile.mjs",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"assets:pull": "node scripts/assets.mjs pull",
		"assets:push": "node scripts/assets.mjs push",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test": "vitest",
		"coverage": "vitest run --coverage",
		"upgrade:ui": "npx shadcn-svelte@latest add button command dialog input kbd label popover scroll-area select separator sheet sonner switch -y -o"
	},
	"devDependencies": {
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.68.0",
		"@maptoolkit/maplibre-logo-control": "^1.1.2",
		"@openmeteo/file-reader": "^0.0.21",
		"@openmeteo/weather-map-layer": "^0.3.1",
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.4",
		"@trivago/prettier-plugin-sort-imports": "^6.0.0",
		"@turf/turf": "^7.4.0",
		"@types/d3": "^7.4.3",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^5.1.0",
		"bits-ui": "^2.20.4",
		"clsx": "^2.1.1",
		"d3": "^7.9.2",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.24.0",
		"globals": "^17.14.0",
		"maplibre-gl": "^6.16.0",
		"mode-watcher": "^1.1.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"rolldown": "^1.2.16",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-persisted-store": "^0.12.0",
		"svelte-sonner": "^1.2.3",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^4.0.1",
		"tailwindcss": "^4.3.4",
		"terra-draw": "^1.39.0",
		"terra-draw-maplibre-gl-adapter": "^1.5.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "^5.1.0"
	}
}
